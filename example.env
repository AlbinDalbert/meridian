# Example environment for running Meridian locally against Ollama.
#
#   cp example.env .env     # .env is gitignored; edit that copy, never this file
#   iex -S mix phx.server   # then open http://localhost:4000/admin
#
# In development, Meridian reads .env itself (config/runtime.exs). Variables set in your shell
# take precedence, e.g. `PORT=4001 mix phx.server`. Releases and tests ignore the file; there,
# set real environment variables (`docker run --env-file .env` also reads this format).
#
# Everything here is optional in development. Values are examples, not secrets.

## Upstream (the model server)

# Ollama's OpenAI-compatible API. Include the /v1 suffix.
# In Docker, use http://host.docker.internal:11434/v1 to reach Ollama on the host.
LLM_BASE_URL=http://localhost:11434/v1

# Bearer token for the upstream. Ollama doesn't check it; leave it empty for no auth header.
LLM_API_KEY=

# Also list the upstream's raw models (e.g. llama3.2) in /v1/models, next to the personas.
EXPOSE_UPSTREAM_MODELS=false

## Admin console

# Enables /admin and is the token you log in with. Unset = /admin is off (404).
# Any value works in development; production requires 32+ characters:
#   openssl rand -base64 48
ADMIN_TOKEN=change-me-local-admin-token

## Sign-in with an OIDC provider (optional; see README "Signing in")

# The provider, exactly as its tokens' `iss`. For WorkOS, your AuthKit domain.
# OIDC_ISSUER=https://your-name.authkit.app

# Admin sign-in. Register http://localhost:4000/admin/auth/callback as the redirect URI.
# The secret is only needed for a confidential client.
# ADMIN_OIDC_CLIENT_ID=
# ADMIN_OIDC_CLIENT_SECRET=
# ADMIN_EMAILS=you@example.com

# Client ids whose access tokens /v1 and /api accept (comma-separated). Unset = API keys only.
# OIDC_AUDIENCES=

## HTTP

# Port to listen on.
PORT=4000

# Browser origins allowed to call /v1 and /api (comma-separated, or *). Unset = none.
# E.g. a local web client dev server:
CORS_ALLOWED_ORIGINS=http://localhost:5173

## Production only
#
# Ignored in development: the database comes from config/dev.exs (the Postgres in compose.yaml)
# and Phoenix uses a built-in development secret. Required or useful when running a release.

# Postgres connection.
# DATABASE_URL=ecto://postgres:postgres@localhost:5432/meridian_prod

# Signs cookies and tokens. Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# Public host name, used to build URLs.
# PHX_HOST=meridian.example.com

# Start the HTTP server when running a release (bin/meridian start).
# PHX_SERVER=true

# Database pool size, and whether to connect to Postgres over IPv6.
# POOL_SIZE=10
# ECTO_IPV6=false

# DNS name that resolves to every node, for clustering. Unset = single node.
# DNS_CLUSTER_QUERY=
